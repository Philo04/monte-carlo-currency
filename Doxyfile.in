PROJECT_NAME           = "Monte Carlo Currency Simulator"
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/docs
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/include @CMAKE_CURRENT_SOURCE_DIR@/src
RECURSIVE              = YES
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PACKAGE        = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

INPUT_ENCODING         = UTF-8
OUTPUT_LANGUAGE        = Russian

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
SEARCHENGINE           = YES